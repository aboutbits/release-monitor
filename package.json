    "@aboutbits/ts-config": "^1.2.1",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@slack/bolt": "^4.7.2",
    "drizzle-orm": "^0.45.2"
  },
  "patchedDependencies": {
    "drizzle-orm@0.45.2": "patches/drizzle-orm@0.45.2.patch"
  }
