    "db:migrate": "bun --bun drizzle-kit migrate",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "prettier": "@aboutbits/prettier-config",
  "devDependencies": {
    "@aboutbits/eslint-config": "^6.1.0",
